FROM node:20-alpine

WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY tsconfig.json ./

# Copy workspace configuration
COPY apps/seo-gateway/package.json ./apps/seo-gateway/
COPY packages ./packages/

# Install all dependencies (including dev)
RUN npm install

# Copy source code
COPY apps/seo-gateway ./apps/seo-gateway/

WORKDIR /app/apps/seo-gateway

# Set default port (can be overridden via environment variable)
ENV PORT=4000
ENV NODE_ENV=development

# Expose default port
EXPOSE 4000

# Start in dev mode (with nodemon/ts-node)
CMD ["npm", "run", "dev"]
