{
  "name": "rick-and-morty",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "--------------------------------Docker commands--------------------------------": "",
    "docker:build": "node ../../tools/docker-helper.js build Dockerfile rick-and-morty",
    "docker:up": "node ../../tools/docker-helper.js up Dockerfile rick-and-morty 80 -d",
    "docker:up:attach": "node ../../tools/docker-helper.js up Dockerfile rick-and-morty 80",
    "docker:attach": "docker attach rick-and-morty",
    "docker:down": "node ../../tools/docker-helper.js down rick-and-morty",
    "docker:logs": "docker logs -f rick-and-morty"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "vite": "^5.0.0"
  }
}