{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "noEmit": false,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"],
      "@monorepo/*": ["../../packages/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
