{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Не влияет на .ts-файлы вообще — только разрешает синтаксис .tsx.
    "jsx": "react-jsx",
    // "DOM" в lib сюда намеренно не добавлен: там, где реально нужен
    // window/document и т.п. — точечно на уровне файла через
    // /// <reference lib="dom" /> (проверено живьём, работает без
    // изменения этого tsconfig) — так не приходится добавлять DOM-глобалы
    // ВСЕМ пакетам разом только потому, что понадобились одному.
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": [],
    "paths": {
      "@packages/*": ["./packages/*"]
    }
  },
  "include": ["packages/**/*"]
}
