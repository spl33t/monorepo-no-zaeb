{
  "name": "monorepo-no-zaeb",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "deps:install": "pnpm install",
    "preinstall": "node tools/check-pnpm.js",
    "--------------------------------Create commands--------------------------------": "",
    "create:app": "node tools/create-app.js",
    "create:package": "node tools/create-package.js",
    "create:docker-compose": "node tools/create-docker-compose.js",
    "--------------------------------Docker-----------------------------------------": "",
    "docker:manager": "node tools/docker-compose-manager.js",
    "docker:up-all": "cross-env DOCKER_TARGET=production docker compose up --build",
    "docker:up-all:watch": "docker compose up --watch --build",
    "docker:down-all": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}