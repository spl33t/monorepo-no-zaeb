{
  "name": "monorepo-no-zaeb",
  "private": true,
  "scripts": {
    "install:all": "npm install",
    "--------------------------------Create commands--------------------------------": "",
    "create:app": "node tools/create-app.js",
    "create:package": "node tools/create-package.js",
    "create:docker-compose": "node tools/create-docker-compose.js",
    "--------------------------------Docker--------------------------------": "",
    "docker:up": "cross-env DOCKER_TARGET=production docker compose up --build",
    "docker:up:watch": "docker compose up --watch --build",
    "docker:up:attach": "docker compose up --build",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.0",
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
