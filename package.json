{
  "name": "monorepo-no-zaeb",
  "private": true,
  "scripts": {
    "--------------------------------Global utils------------------------------------": "",
    "deps:install": "node tools/cli/install-deps.js",
    "kill:port": "node tools/cli/kill-port.js",
    "--------------------------------Docker-----------------------------------------": "",
    "docker:create-compose": "node tools/cli/create-docker-compose.js",
    "docker:compose-manager": "node tools/cli/docker-compose-manager.js",
    "docker:up-all": "cross-env DOCKER_TARGET=production docker compose up --build",
    "docker:up-all:watch": "docker compose up --watch --build",
    "docker:down-all": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "yaml": "^2.8.2"
  }
}
